server {
    listen 80;
    listen 443 ssl;
    server_name shop-api.54-90-159-53.sslip.io;

    ssl_certificate /etc/letsencrypt/live/shop-api.54-90-159-53.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop-api.54-90-159-53.sslip.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
